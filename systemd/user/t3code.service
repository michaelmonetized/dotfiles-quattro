[Unit]
Description=T3 Code server
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
Environment=T3CODE_HOME=/home/michael/.t3
Environment=T3_BOOT_SERVICE_UNIT=t3code.service
ExecStart=/home/michael/.t3/runtime/versions/0.0.46-nightly.20261010.2922/t3 __service-launcher
KillMode=mixed
OOMPolicy=continue
Restart=always
RestartSec=5
CPUWeight=1000
IOWeight=1000
ManagedOOMPreference=avoid
StandardOutput=append:/home/michael/.t3/userdata/logs/boot-service.log
StandardError=append:/home/michael/.t3/userdata/logs/boot-service.log

[Install]
WantedBy=default.target
