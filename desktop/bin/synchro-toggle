#!/usr/bin/env python3
import fcntl, json, os, subprocess, sys, time
lock = open(os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'), 'synchro-toggle.lock'), 'w')
fcntl.flock(lock, fcntl.LOCK_EX)
def query(kind):
    return json.loads(subprocess.check_output(['hyprctl', '-j', kind]))
clients = [w for w in query('clients') if w['class'] == 'org.omarchy.synchro' and not w['title'].startswith(('Open', 'Save', 'Select', 'Choose'))]
active = query('activewindow').get('address')
if clients:
    focused = next((w for w in clients if w['address'] == active), None)
    address = 'address:' + (focused or clients[0])['address']
    operation = 'hl.dsp.window.close' if focused else 'hl.dsp.focus'
    subprocess.run(['hyprctl', 'dispatch', operation + '({ window = ' + json.dumps(address) + ' })'], check=True)
else:
    subprocess.Popen(['synchro', *sys.argv[1:]], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    for _ in range(50):
        if any(w['class'] == 'org.omarchy.synchro' for w in query('clients')): break
        time.sleep(.1)
