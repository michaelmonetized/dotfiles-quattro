#!/usr/bin/env python3
import json, os, pathlib, select, socket, struct, subprocess, sys
runtime = pathlib.Path(os.environ['XDG_RUNTIME_DIR']) / 'browser-keys'
runtime.mkdir(mode=0o700, exist_ok=True)
def read():
    header = sys.stdin.buffer.read(4)
    if len(header) != 4: raise EOFError
    size = struct.unpack('=I',header)[0]
    if size > 1024*1024: raise ValueError('Oversized message')
    return json.loads(sys.stdin.buffer.read(size))
def write(value):
    data=json.dumps(value).encode(); sys.stdout.buffer.write(struct.pack('=I',len(data))+data);sys.stdout.buffer.flush()
hello=read(); flavor=hello['browser']
if flavor not in ('chrome','zen'): raise SystemExit(1)
path=runtime / f'{flavor}-{os.getpid()}.sock'
server=socket.socket(socket.AF_UNIX);server.bind(str(path));os.chmod(path,0o600);server.listen(4)
try:
    while True:
        ready,_,_=select.select([server,sys.stdin.buffer],[],[])
        if sys.stdin.buffer in ready: read()
        if server in ready:
            client,_=server.accept()
            with client:
                client.settimeout(5)
                request=json.loads(client.recv(4096));write(request)
                if not select.select([sys.stdin.buffer],[],[],10)[0]:
                    client.sendall(b'{"ok":false,"error":"Extension response timed out"}');continue
                response=read()
                if response.get('clipboard'):
                    subprocess.run(['wl-copy'],input=response.pop('clipboard').encode(),check=True)
                client.sendall(json.dumps(response).encode())
except (EOFError,BrokenPipeError): pass
finally: path.unlink(missing_ok=True)
